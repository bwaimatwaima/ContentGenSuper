{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "owner"] },
        "status": { "type": "string", "enum": ["active", "pending", "banned"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "status"]
    },
    "TestProbe": {
      "title": "TestProbe",
      "description": "Connection probe document.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles collection."
    },
    "test/{docId}": {
      "schema": {
        "$ref": "#/entities/TestProbe"
      },
      "description": "Test connectivity collection."
    }
  }
}
