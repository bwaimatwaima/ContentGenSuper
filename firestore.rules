rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'bwaimatwaima@gmail.com'));
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    // Test Probe
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }
  }
}
