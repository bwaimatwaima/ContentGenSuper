rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'RqynWxsBSTX7DUlheLVdckDXq3g2' ||
        request.auth.token.email == 'bwaimatwaima@gmail.com' ||
        request.auth.token.email == 'BwaimaTwaima@gmail.com' ||
        request.auth.token.email == 'youngpastor808@gmail.com' ||
        request.auth.token.email == 'YoungPastor808@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() in ['bwaimatwaima@gmail.com', 'youngpastor808@gmail.com'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection & User Settings Subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSignedIn() && isSuperAdmin();

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Pre-approved Emails & Deleted/Banned User Tracking
    match /approvedEmails/{email} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /deletedUsers/{email} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Global and Public Settings (Public config, maintenance, ads)
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Credit Ledger Transactions
    match /creditLedger/{ledgerId} {
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // Usage Tracking
    match /usage/{userId} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Video Projects, Storyboard Scenes & Shots
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    match /scenes/{sceneId} {
      allow read, write: if isSignedIn();
    }

    match /shots/{shotId} {
      allow read, write: if isSignedIn();
    }

    // Academy Curriculum & Lessons
    match /academy_courses/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Connection Health Test Probe
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }
  }
}
