rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'bwaimatwaima@gmail.com'));
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    // Credit Ledger Transactions
    match /creditLedger/{ledgerId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Daily Usage Metrics
    match /usage/{userId}/daily/{dayKey} {
      allow get, list, create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Scenes & Shots
    match /scenes/{sceneId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /shots/{shotId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Test Probe
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }
  }
}
